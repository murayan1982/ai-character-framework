# =========================================
# Required (LLM)
# =========================================

GEMINI_API_KEY=your_gemini_api_key_here


# =========================================
# Optional: Additional LLM Provider
# =========================================

XAI_API_KEY=your_xai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here


# =========================================
# Optional: Voice Output (ElevenLabs)
# =========================================

# Public FW voice output boundary / real provider execution guard
# Keep execution disabled unless you are intentionally running a configured real TTS check.
FRAMEWORK_VOICE_OUTPUT_REAL_TTS=0
FRAMEWORK_VOICE_OUTPUT_PROVIDER=
FRAMEWORK_VOICE_OUTPUT_ALLOW_PROVIDER_EXECUTION=0
FRAMEWORK_VOICE_OUTPUT_ARTIFACT_DIR=

ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# JSON array of voice objects
VOICE_MASTER=[{"id":"your_voice_id_here","name":"MyVoice"}]

APP_PRESET=text_chat
INPUT_LANGUAGE_CODE=ja
OUTPUT_LANGUAGE_CODE=ja
# =========================================
# Notes
# =========================================

# - Runtime behavior is primarily controlled by APP_PRESET and presets/*.json
# - Character behavior is controlled by characters/<character_name>/system.txt
# - VTube Studio token is generated automatically on first run

# =========================================
# Candidate Public Motion / VTube Studio Adapter
# =========================================

# Reserved by FW-VTS-0a for the proposed v5.5.0 real-motion adapter line.
# These values have no runtime effect in FW-VTS-0a.
# Keep both execution guards closed for normal import, mock sessions, tests,
# capability inventory, and source-package verification.
FRAMEWORK_MOTION_REAL_ADAPTER=0
FRAMEWORK_MOTION_ALLOW_PROVIDER_EXECUTION=0
FRAMEWORK_MOTION_ADAPTER=mock

# The legacy full runtime may bootstrap a VTube Studio token on an explicit
# legacy VTS run. The future root-public MotionSession adapter will not silently
# bootstrap a token during normal preflight. Token values and token paths remain
# Framework-internal and must never be committed or exposed to host apps.
